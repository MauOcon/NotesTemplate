\newcommand{\tmplLatexPackage}[1]{%
	\pdftooltip{%		
		\tcbox[
		on line,
		colback=gray!10,
		colframe=gray!10,
		boxrule=0pt,
		boxsep=0pt,
		left=0pt,
		right=0pt,
		top=0pt,
		bottom=0pt
		]{%
			% BASIC COLORS, there are more with dvipsnames
			% red, green, blue, cyan, magenta, yellow, black, gray, white
			% darkgray, lightgray, brown, lime, olive, orange, pink, purple, teal, violet
			\color{Violet}
			\faBox\space
			{\fontfamily{SourceCodePro-TLF}%
				\fontseries{el}% Available series: el (extra-light), l (light), m (regular), sb (semibold), b (bold), bx (black).
				\fontsize{\dimexpr\f@size pt + 0pt\relax}{\dimexpr\f@size pt + 0pt\relax}%
				\selectfont #1%
			}%
		}%
	}{LaTeX Package}%	
}

