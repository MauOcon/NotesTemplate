\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TemplatePackage}[2026/06/15 My custom template package]
\RequirePackage[type1]{sourcecodepro} % Fuente con más grosores o pesos disponibles

% Adds actual font size + 1pt: \dimexpr\f@size pt + 1pt\relax
\newcommand{\textthinmono}[1]{%
	{%
		\fontfamily{SourceCodePro-TLF}% 
		\fontseries{el}% Available series: el (extra-light), l (light), m (regular), sb (semibold), b (bold), bx (black).
		\fontsize{\dimexpr\f@size pt + 1pt\relax}{\dimexpr\f@size pt + 0pt\relax}%
		\selectfont #1%
	}%
}

