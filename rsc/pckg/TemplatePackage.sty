\RequirePackage{menukeys}
% Utilizar para indicar la rutas en un archivo de código, por ejemplo el path de un elemento json o xml
\newcommand{\tmplCodePath}[1]{
	\menu{#1}
}

\newcommand{\tmplPath}[1]{
	\directory{#1}
}

% Utilizar para escribir cosas que están por corroborar
\newcommand{\tmplTemporal}[1]{%
	\pdftooltip{%
		\sethlcolor{Yellow!50}%
		{
			\color{BurntOrange}%
			\fontfamily{SourceCodePro-TLF}%
			\fontseries{m}%
			\selectfont\hl{\faExclamationTriangle\space #1}
		}%
	}{Corroborar info}%
}

\newcommand{\tmplTerm}[1]{%
	{\color{NavyBlue}\textbf{#1}}%
}

\newcommand{\tmplTermEn}[1]{%
	{\color{NavyBlue}\textbf{\it#1}}%
}


\RequirePackage{tcolorbox}

% Se utiliza para resaltar los objetivos de la sección
\newcounter{objective}[section]
\renewcommand{\theobjective}{\thesection.\arabic{objective}}

\newtcolorbox{tmplObjective}[1][]{%
	before upper={\refstepcounter{objective}\setlength{\parskip}{0pt}},
	title={\large\textbf{Objetivo~\theobjective}},
	colback=white,
	colframe=black!30,
	fontupper=\itshape,
	left=10pt,
	#1
}

\newtcolorbox{tmplSummary}[1][]{%
	before upper={\refstepcounter{objective}\setlength{\parskip}{0pt}},
	title={\large\textbf{Resumen~\theobjective}},
	colback=white,
	colframe=black!30,
	fontupper=\itshape,
	left=10pt,
	#1
}

\newcounter{chaptersummary}[chapter]
\renewcommand{\thechaptersummary}{\thechapter.\arabic{chaptersummary}}
\newtcolorbox{tmplChapterSummary}[1][]{%
	title={\large\textbf{Resumen del Capítulo~\thechapter}},
	colback=white,
	colframe=black!30,
	fontupper=\itshape,
	left=10pt,
	before upper={\setlength{\parskip}{0pt}},
	#1
}



\RequirePackage{changepage}
\RequirePackage{etoolbox}
% Cambiar aquí para modificar todas las citas: left, center, right
\newcommand{\tmplquotealign}{right}
\newlength{\tmplquotemargin}

\newenvironment{tmplquote}[1]{%
	\par\medskip
	\def\tmpl@quoteauthor{#1}%
	\setlength{\tmplquotemargin}{0.125\textwidth}%
	\ifdefstring{\tmplquotealign}{center}{%
		\begin{adjustwidth}{\tmplquotemargin}{\tmplquotemargin}%
		}{%
			\ifdefstring{\tmplquotealign}{right}{%
				\begin{adjustwidth}{0.25\textwidth}{0pt}%
				}{%
					\begin{adjustwidth}{0pt}{0.25\textwidth}%
					}%
				}%
				\itshape\noindent\ignorespaces
			}{%
				\par\nopagebreak\smallskip
				\normalfont\raggedleft---\ \tmpl@quoteauthor\par
			\end{adjustwidth}%
			\medskip
		}
		
		\RequirePackage{tikz}
		\RequirePackage{xcolor}
		
